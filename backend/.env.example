# Read by the backend from backend/.env, independent of working directory.
APP_NAME=JD Select
APP_ENV=development
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# SQLite relative paths resolve from backend/, regardless of working directory.
# Tables are created on startup. Existing tables are never dropped.
DATABASE_URL=sqlite:///./jd_select.db
# Optional OpenAI-compatible STAR suggestions. Leave blank for deterministic rule fallback.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
